        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="S02_Login_Success" enabled="true">
          <stringProp name="TestPlan.comments">Successful auth and token extraction for subsequent protected requests.</stringProp>
          <boolProp name="TransactionController.parent">true</boolProp>
        </TransactionController>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Scenario Header S02_Login_Success" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="X-Test-Scenario" elementType="Header">
