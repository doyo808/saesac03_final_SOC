        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="S07_Rapid_Login_Failures" enabled="true">
          <stringProp name="TestPlan.comments">Short-interval repeated login failures for alerting/log pattern checks.</stringProp>
          <boolProp name="TransactionController.parent">true</boolProp>
        </TransactionController>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Scenario Header S07_Rapid_Login_Failures" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="X-Test-Scenario" elementType="Header">
                <stringProp name="Header.name">X-Test-Scenario</stringProp>
                <stringProp name="Header.value">S07_Rapid_Login_Failures</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree />
          <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Rapid Fail Loop Controller" enabled="true">
            <stringProp name="TestPlan.comments">Low count by default; increase carefully.</stringProp>
            <stringProp name="LoopController.loops">${rapid_fail_loops}</stringProp>
            <boolProp name="LoopController.continue_forever">false</boolProp>
          </LoopController>
          <hashTree>
            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Rapid Fail Interval" enabled="true">
              <stringProp name="ConstantTimer.delay">${rapid_fail_interval_ms}</stringProp>
            </ConstantTimer>
            <hashTree />
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="loginFailureBurst" enabled="true">
