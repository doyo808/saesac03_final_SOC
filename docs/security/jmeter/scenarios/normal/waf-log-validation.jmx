        </hashTree>

        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC_custom_lfi_marker_990123" enabled="true">
          <stringProp name="TestPlan.comments">Custom LFI marker log path for rule 990123.</stringProp>
          <boolProp name="TransactionController.parent">false</boolProp>
        </TransactionController>
        <hashTree>
