          <stringProp name="TestPlan.comments">Custom CMD marker log path for rule 990124.</stringProp>
          <boolProp name="TransactionController.parent">false</boolProp>
        </TransactionController>
        <hashTree>
          <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Loop_custom_cmd_marker_990124" enabled="true">
            <stringProp name="LoopController.loops">${scenario_loops}</stringProp>
