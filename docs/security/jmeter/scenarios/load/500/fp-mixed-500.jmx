      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Public Search Location Thread Group" enabled="true">
        <stringProp name="TestPlan.comments">Adds 50 public GET requests across announcement search variants, public routes, and typo-style paths.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
