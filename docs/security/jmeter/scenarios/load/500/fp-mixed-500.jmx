            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture LMS Normal Assignment ID Mini" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename" />
              <stringProp name="parameters" />
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

vars.put('lms_normal_assignment_id', '0')

def raw = prev.getResponseDataAsString()
if (!raw) {
    return
}

def parsed
try {
    parsed = new JsonSlurper().parseText(raw)
} catch (Exception ignored) {
    return
}

if (!(parsed instanceof List) || parsed.isEmpty()) {
    return
}

def first = parsed[0]
if (first instanceof Map &amp;&amp; first.id != null) {
    vars.put('lms_normal_assignment_id', first.id.toString())
}</stringProp>
