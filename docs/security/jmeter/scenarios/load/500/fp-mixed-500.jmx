            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture LMS Course IDs Mini" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename" />
              <stringProp name="parameters" />
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

vars.put('lms_course_cs101_id', '0')
vars.put('lms_course_sec330_id', '0')

def raw = prev.getResponseDataAsString()
if (!raw) {
    return
}

def parsed
try {
    parsed = new JsonSlurper().parseText(raw)
} catch (Exception ignored) {
    return
}

if (!(parsed instanceof List)) {
    return
}

parsed.findAll { it instanceof Map }.each { course -&gt;
    def code = course.code?.toString()
    def id = course.id?.toString()
    if (!id) {
        return
    }
    if (code == 'CS101') {
        vars.put('lms_course_cs101_id', id)
    }
    if (code == 'SEC330') {
        vars.put('lms_course_sec330_id', id)
    }
}</stringProp>
            </JSR223PostProcessor>
