              <stringProp name="parameters" />
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

vars.put('lms_ambiguous_assignment_id', '0')
vars.put('lms_attack_assignment_id', '0')

def raw = prev.getResponseDataAsString()
if (!raw) {
    return
}

def parsed
try {
    parsed = new JsonSlurper().parseText(raw)
} catch (Exception ignored) {
    return
}

if (!(parsed instanceof List) || parsed.isEmpty()) {
    return
}

def first = parsed[0]
if (first instanceof Map &amp;&amp; first.id != null) {
    vars.put('lms_ambiguous_assignment_id', first.id.toString())
    vars.put('lms_attack_assignment_id', first.id.toString())
}

if (parsed.size() &gt; 1) {
    def second = parsed[1]
    if (second instanceof Map &amp;&amp; second.id != null) {
        vars.put('lms_attack_assignment_id', second.id.toString())
    }
}</stringProp>
