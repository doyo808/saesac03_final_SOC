              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Accept Expanded Search Statuses" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename" />
                <stringProp name="parameters" />
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="script">def code = prev.getResponseCode()
def allowed = ['200','201','204','400','401','403','404','409']
if (!allowed.contains(code)) {
  prev.setSuccessful(false)
  prev.setResponseMessage((prev.getResponseMessage() ?: '') + ' | unexpected-status')
}</stringProp>
              </JSR223PostProcessor>
              <hashTree />
            </hashTree>
          </hashTree>
        </hashTree>
