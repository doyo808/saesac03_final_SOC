                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename" />
                <stringProp name="parameters" />
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="script">def code = prev.getResponseCode()
if (['200', '301', '302', '400', '401', '403', '404', '405'].contains(code)) {
    prev.setSuccessful(true)
    prev.setResponseMessage('Accepted typo URL status: ' + code)
}</stringProp>
              </JSR223PostProcessor>
              <hashTree />
            </hashTree>
          </hashTree>
        </hashTree>
      </hashTree>
