            <collectionProp name="HeaderManager.headers">
                <elementProp name="Referer" elementType="Header">
                  <stringProp name="Header.name">Referer</stringProp>
                  <stringProp name="Header.value">http://${waf_host}/login</stringProp>
                </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
        </hashTree>
