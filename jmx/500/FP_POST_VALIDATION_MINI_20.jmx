          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="LMS Setup Get SEC330 Assignments Mini" enabled="true">
            <stringProp name="HTTPSampler.path">/api/lms/courses/${lms_course_sec330_id}/assignments</stringProp>
