          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Resolve Public POST Mini Request" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">import org.apache.jmeter.engine.util.CompoundVariable

def resolve = { raw -&gt;
    raw == null ? &apos;&apos; : new CompoundVariable(raw).execute()
}

vars.put(&apos;resolved_request_path&apos;, resolve(vars.get(&apos;request_path&apos;)))
vars.put(&apos;resolved_request_body&apos;, resolve(vars.get(&apos;request_body&apos;)))

if (sampler != null) {
    sampler.setName(&apos;Public POST &apos; + (vars.get(&apos;case_id&apos;) ?: &apos;unknown&apos;) + &apos; [&apos; + (vars.get(&apos;case_class&apos;) ?: &apos;unknown&apos;) + &apos;]&apos;)
}</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
