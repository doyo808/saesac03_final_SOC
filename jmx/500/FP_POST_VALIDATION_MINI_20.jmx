                  <stringProp name="Header.value">application/json, text/plain, */*</stringProp>
                </elementProp>
                <elementProp name="Authorization" elementType="Header">
                  <stringProp name="Header.name">Authorization</stringProp>
                  <stringProp name="Header.value">Bearer ${student_access_token}</stringProp>
                </elementProp>
                <elementProp name="X-FP-Case-ID" elementType="Header">
                  <stringProp name="Header.name">X-FP-Case-ID</stringProp>
                  <stringProp name="Header.value">auth_setup_lms_003</stringProp>
                </elementProp>
                <elementProp name="X-FP-Case-Class" elementType="Header">
                  <stringProp name="Header.name">X-FP-Case-Class</stringProp>
                  <stringProp name="Header.value">setup</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture LMS Security Assignment IDs Mini" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

vars.put(&apos;lms_ambiguous_assignment_id&apos;, &apos;0&apos;)
vars.put(&apos;lms_attack_assignment_id&apos;, &apos;0&apos;)

def raw = prev.getResponseDataAsString()
if (!raw) {
    return
}

def parsed
try {
    parsed = new JsonSlurper().parseText(raw)
} catch (Exception ignored) {
    return
}

if (!(parsed instanceof List)) {
    return
}

if (parsed.size() &gt; 0) {
    def first = parsed[0]
    if (first instanceof Map &amp;&amp; first.id != null) {
        vars.put(&apos;lms_ambiguous_assignment_id&apos;, first.id.toString())
    }
}

if (parsed.size() &gt; 1) {
    def second = parsed[1]
    if (second instanceof Map &amp;&amp; second.id != null) {
        vars.put(&apos;lms_attack_assignment_id&apos;, second.id.toString())
    }
}</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
