                    <stringProp name="filename">${__groovy(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir() + java.io.File.separator + (props.get('url_typo_csv') ?: 'url-typo-fp-100.csv'))}</stringProp>
            <boolProp name="ignoreFirstLine">true</boolProp>
