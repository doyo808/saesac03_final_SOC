                  <stringProp name="Header.name">Authorization</stringProp>
                  <stringProp name="Header.value">Bearer ${board_access_token}</stringProp>
                </elementProp>
                <elementProp name="X-Timeout-Bucket" elementType="Header">
                  <stringProp name="Header.name">X-Timeout-Bucket</stringProp>
                  <stringProp name="Header.value">confirmed_timeout</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree />
