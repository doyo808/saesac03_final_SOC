        <!-- ==================== PART 2: refresh_token 쿠키 변조 공격 ==================== -->

        <!-- 테스트 6: refresh_token 쿠키 변조 (잘못된 값) 후 refresh API 호출 -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="[ATTACK] Tampered refresh_token cookie" enabled="true">
          <stringProp name="HTTPSampler.domain">${waf_host}</stringProp>
