                <stringProp name="Header.value">true</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
        </hashTree>

        <!-- 테스트 3: JWT alg: none 공격 -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="[ATTACK] JWT alg: none attack" enabled="true">
          <stringProp name="HTTPSampler.domain">${waf_host}</stringProp>
